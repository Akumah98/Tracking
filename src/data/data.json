  "faqs": [
    { "id": "faq1", "question": "How do I track multiple shipments at once?", "answer": "Enter up to 5 tracking numbers separated by commas or on separate lines in the Hero Search Bar on the home page. The system will identify carriers automatically and display all results simultaneously." },
    { "id": "faq2", "question": "How accurate is the AI Estimated Delivery Date?", "answer": "Our AI EDD engine is trained on 4.4 billion historical shipments and achieves 95% accuracy. A confidence indicator is displayed alongside every prediction." },
    { "id": "faq3", "question": "Which EDI standards are supported?", "answer": "We support ANSI X12 (EDI 214 Road Status, EDI 315 Ocean Status) and EDIFACT via AS2 or SFTP protocols, covering all major North American and international carrier standards." },
    { "id": "faq4", "question": "How quickly is shipment data refreshed?", "answer": "Active shipments are polled and refreshed at a sub-60-minute cadence. Real-time IoT-enabled shipments (via Tive or project44 feeds) update instantly via webhook push." },
    { "id": "faq5", "question": "Is consignee data GDPR compliant?", "answer": "Yes. All PII is encrypted at rest and in transit. Our platform is fully compliant with EU GDPR, including right-to-erasure workflows for consignee data." }
