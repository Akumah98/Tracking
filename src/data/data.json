  "faqs": [
    {
      "id": "faq1",
      "question": "How do I track my International Transport Line shipment?",
      "answer": "Simply enter your Consignment or Waybill number (e.g. ITL-894201-US) into the tracking bar on this page to view live telemetry, current hub location, and ETA."
    },
    {
      "id": "faq2",
      "question": "What makes your shipping friction-free?",
      "answer": "We eliminate traditional logistics friction: no box or label required when dropping off packages, automated customs documentation, and direct point-to-point courier handoffs."
    },
    {
      "id": "faq3",
      "question": "How do you handle delicate or high-value items?",
      "answer": "Our white-glove logistics division specializes in fragile and high-value cargo with personalized handling, shock and climate monitoring, and dedicated transit vehicles."
    },
    {
      "id": "faq4",
      "question": "How are international customs handled?",
      "answer": "Our dedicated customs brokerage team pre-clears shipments electronically before cargo arrival, preventing warehouse holding delays."
    }
